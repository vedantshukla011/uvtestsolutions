		position: relative;
		float: left;

	}

	.logo img {
		width: 250px;
	}

	.header-banner-info.sticky .logo img {
		width: 235px;
		margin-top: 10px;
	}



	.left_btn.n_btn a {
		background: #fff;
		color: #000;
		border-right: 1px solid #000;
		border-radius: 0;
		margin: 0 -5px;
	}

	.left_btn.n_btn a:first-child {
		border: none;
		padding: 0;
	}

	.scroll-hide {
		bottom: 15%;
		position: fixed;
		z-index: 5;
		right: 0px;
		transition: ease all 0.4s;

	}

	._inno_ul li {
		width: 25% !important;
	}

	.scroll-hide.open {
		right: -302px;
	}

