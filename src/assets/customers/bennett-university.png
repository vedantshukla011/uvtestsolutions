			display: none;
		}

		.menu-toggle {
			background: none;
			border: none;
			cursor: pointer;
			padding: 5px;
		}

		.menu-toggle span {
			display: block;
			width: 25px;
			height: 3px;
			background: #333;
			margin: 5px 0;
			transition: 0.3s;
		}

		#mainMenu {
			top: 70px;
		}


		/* Menu Overlay */
		.menu-overlay {
			position: fixed;
			top: 0;
			left: -100%;
			width: 100%;
			height: 100vh;
			background: #336699;
			z-index: 1000;
			transition: left 0.3s ease;
			overflow-y: auto;
			overflow-x: hidden;
		}

		.menu-overlay.active {
			left: 0;
		}

		/* Menu Header */
		.menu-header {
			position: sticky;
			top: 0;
			z-index: 1001;
			background: #fff;
			padding: 1px 20px;
			display: flex;
			justify-content: space-between;
			align-items: center;
			border-bottom: 1px solid #333;
		}

		.menu-logo {
			height: 40px;
		}

		.close-btn {
			background: none;
			border: none;
			color: #000;
			font-size: 55px;
			cursor: pointer;
			padding: 5px;
			line-height: 1;
		}

		/* Back Button Section */
		.back-section {
			position: sticky;
			top: 0px;
			/* below header */
			z-index: 1000;
			background: #e31e24;
			padding: 15px 20px;
			border-bottom: 1px solid #2c5a87;
			display: none;
			align-items: center;
			gap: 15px;
			cursor: pointer;
		}

		.back-section.active {
			display: flex;
		}

		.back-arrow {
			color: white;
			font-size: 20px;
		}

		.current-menu-title {
			color: white;
			font-size: 16px;
			font-weight: normal;
		}

		/* Menu Content */
		/* .menu-slide {
        display: none;
        min-height: calc(100vh - 70px);
      }

      .menu-slide.active {
        display: block;
      } */

		.menu-slide {
			position: absolute;
			top: 130px;
			/* header (70px) + back-section (50px) */
			left: 0;
			width: 100%;
			height: calc(100vh - 120px);
			background: #336699;
			color: #fff;
			transform: translateX(100%);
			opacity: 0;
			transition: transform 0.4s ease, opacity 0.4s ease;
			pointer-events: none;
			overflow-y: auto;
			/* independent scrolling for content */
		}

		.menu-slide.active {
			transform: translateX(0);
			opacity: 1;
			pointer-events: auto;
		}

		.menu-list {
			list-style: none;
			padding: 0;
			margin: 0;
		}

		.menu-list>li {
			border-bottom: 1px solid #ffffff59;
		}

		.menu-list>li>a {
			display: flex;
			justify-content: space-between;
			align-items: center;
			padding: 10px 20px;
			color: white;
			text-decoration: none;
			font-size: 16px;
			transition: background 0.2s;
		}

		.menu-list>li>a:hover {
			background: #235281;
		}

		.menu-list>li>a span {
			font-size: 20px;
		}

		/* Dropdown Accordion */
		.dropdown {
			background: #1d5287;
			border-bottom: 1px solid #186bbd;
		}

		.dropdown-header {
			display: flex;
			justify-content: space-between;
			align-items: center;
			padding: 18px 20px;
			color: white;
			cursor: pointer;
			font-size: 16px;
			transition: background 0.2s;
		}

		.dropdown-header:hover {
			background: #235281;
		}

		.dropdown-icon {
			font-size: 20px;
			transition: transform 0.3s;
		}

		.dropdown.open .dropdown-icon {
			transform: rotate(180deg);
		}

		.dropdown-content {
			max-height: 0;
			overflow: hidden;
			transition: max-height 0.3s ease;
			background: #124375;
		}

		.dropdown.open .dropdown-content {
			max-height: max-content;
		}

		.dropdown-content ul {
			list-style: none;
			padding: 0;
		}

		.dropdown-content li {
			border-top: 1px solid #ffffff70;
			padding: 12px 20px 12px 40px;
		}

		.gb_menu .inner_menu {
			padding: 12px 20px 12px 0px;
		}

		.dropdown-content li a {
			display: block;

			color: #fff;
			text-decoration: none;
			font-size: 15px;
			transition: all 0.2s;
		}

		.dropdown-content li a:hover {
			background: #235281;
			color: white;
			padding-left: 45px;
		}

		.bu-quicklinks {
			padding: 20px;
		}

		.bu-quicklinks>ul {
			padding: 0px !important;
			list-style: none;
			display: flex;
			flex-wrap: wrap;
		}

		.bu-quicklinks>ul li {
			width: 49%;
			margin: 4px 0;
		}

		.bu-quicklinks>ul li a {
			color: #d9d9d9;
			font-size: 14px;
			font-weight: 500;
			text-decoration: none;
		}

		.apply-btn {
			background: #e31e24;
			color: white;
			border: none;
			padding: 15px;
			width: 100%;
			font-size: 16px;
			font-weight: bold;
			cursor: pointer;
			border-radius: 5px;
			margin: 20px 0px;
		}

		.social-links {
			display: flex;
			justify-content: center;
			gap: 15px;
		}

		.social-links a {
			width: 35px;
			height: 35px;

			border: 1px solid #fff;
			border-radius: 100%;
			display: flex;
			align-items: center;
			justify-content: center;
			color: #fff;
			text-decoration: none;
			font-weight: bold;
		}

		.inner_menu h3 {
			color: #fff;
			font-size: 18px;
			font-weight: 500;
			padding-left: 20px;
		}

		h3.school_title a {
			color: #fff;
			padding: 18px 5px 3px 18px;
			display: inline-block;
			text-decoration: none;
			font-weight: 500;
		}

		.default-chatbot-indicator.open {
			display: none !important;
		}


		.container-dyn {
			max-width: 1400px;
			margin: 0 auto;
			padding: 20px;
		}

		.header-dyn {
			text-align: center;
			margin-bottom: 20px;
			background: linear-gradient(135deg, #3d5a80 0%, #4a6fa5 100%);
			padding: 20px;
			border-radius: 10px;
		}

		.header-dyn h1 {
			color: white;
			font-size: 2.5rem;
			margin-bottom: 5px;
		}

		.header-dyn p {
			color: rgba(255, 255, 255, 0.9);
			font-size: 1.1rem;
		}

		.tabs-container-dyn {
			display: flex;
			gap: 30px;

			border-radius: 10px;
			box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
			overflow: hidden;
			min-height: 600px;
		}

		.tabs-sidebar-dyn {
			width: 350px;
			background: #20568d;
			padding: 20px 0;
		}

		.tab-button-dyn {
			display: block;
			width: 100%;
			padding: 7px 30px;
			text-align: left;
			background: transparent;
			border: none;
			color: rgba(255, 255, 255, 0.8);
			font-size: 0.95rem;
			cursor: pointer;
			transition: background 0.2s ease, color 0.2s ease, border-left-color 0.2s ease;
			border-left: 4px solid transparent;
			will-change: background, color, border-left-color;
		}

		.tab-button-dyn:hover {
			background: rgba(255, 255, 255, 0.15);
			color: white;
			border-left-color: #e74c3c;
		}

		.tab-button-dyn.active-dyn {
			background: rgba(255, 255, 255, 0.2);
			color: white;
			border-left-color: #e74c3c;
			font-weight: 600;
		}

		.tab-content-area-dyn {
			flex: 1;
			padding: 20px 40px;
			overflow-y: auto;
			max-height: 600px;
		}

		.tab-content-dyn {
			display: none;
			min-height: 500px;
		}

		.tab-content-dyn.active-dyn {
			display: block;
			animation: fadeIn-dyn 0.2s ease;
		}

		@keyframes fadeIn-dyn {
			from {
				opacity: 0;
			}

			to {
				opacity: 1;
			}
		}

		.content-title-dyn a {
			color: #fff;
			font-size: 20px;
			margin: 0px 0 15px;
			border-bottom: 3px solid #e74c3c;
			text-decoration: none;
		}

		.section-dyn {
			margin-bottom: 12px;
			width: 100%;
			float: left;
			border-bottom: 1px solid #ffffff26;
			padding-bottom: 12px;
		}

		.section-dyn h3 {
			color: #fff;
			font-size: 16px;
			margin-bottom: 10px;
			display: flex;
			align-items: center;
		}

		.list-dyn {
			list-style: none;
			display: grid;
			grid-template-columns: repeat(2, 1fr);

		}


		.list-dyn li {
			display: block;
			padding: 0px 20px;
			color: #fff;
			position: relative;
			font-size: 14px;
			transition: all 0.2s ease;
			background: var(--wpr-bg-6730ff97-ccdf-4c73-8792-c0cd5a8900be) 0px 7px no-repeat;

		}

		.list-dyn li a {
			font-size: 14px;
			color: #fff;
			text-decoration: none;
		}
	</style>



