		<div data-rocket-location-hash="68ed30ca88379a4826cddddc114258df" class="menu-slide" id="innocenterMenu">
			<ul class="menu-list">

				<li><a href="https://www.bennett.edu.in/innovation-centre/" target="_blank" rel="noopener noreferrer">About Innovation Center</a></li>

				<li class="aa active"><a href="https://www.bennett.edu.in/innovation-centre/about-us/">About Us</a>
					<meta itemprop="name" content="PLACEMENTS AY 2022">
					<meta itemprop="url" content="https://www.bennett.edu.in/innovation-centre/about-us/">
				</li>
				<li class="aa"><a href="https://www.bennett.edu.in/innovation-centre/mentors/">Mentors</a>
					<meta itemprop="name" content="Mentors">
					<meta itemprop="url" content="https://www.bennett.edu.in/innovation-centre/mentors/">
				</li>
				<li class="aa"><a href="https://www.bennett.edu.in/innovation-centre/startup-portfolio/">Startup Portfolio</a>
					<meta itemprop="name" content="Mentors">
					<meta itemprop="url" content="https://www.bennett.edu.in/innovation-centre/startup-portfolio/">
				</li>
				<li class="aa"><a href="https://www.bennett.edu.in/innovation-centre/spark-cell/">Spark Cell</a>
