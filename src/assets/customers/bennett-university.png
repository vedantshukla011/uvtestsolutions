	.socialtwitter {
		display: none;
	} */
	.tp_slide {
		display: none;
	}

	.scroll-hide button {
		border: none;
		padding: 4px 12px;
		background: #da2032;
		color: #ffffff;
		display: inline-block;
		font-size: 16px;
		font-weight: 600;
		height: 42px;
		width: 42%;
		left: -82px;
		border-radius: 6px;

		top: 96px;
		text-decoration: none;
		line-height: 33px;
		position: absolute;
		justify-content: center;
		text-align: center;
		text-transform: uppercase;
		-moz-transform: rotate(-90deg);
		-ms-transform: rotate(-90deg);
		-o-transform: rotate(-90deg);
		-webkit-transform: rotate(-90deg);

	}

	.topheadsection {
		display: none;
	}

	.stickyform2 a {
		width: 49px;
		height: 153px;
	}
.stylish-enquire {
    max-width: 100%;
    background: #ffffff;
    border-radius: 6px;
    box-shadow: 0 6px 25px rgba(0,0,0,0.08);
    overflow: hidden;
    border: 1px solid #e5e5e5;
}

/* Dark Header like Image 1 */
.stylish-enquire .enquire-header {
    background: #0b2b55;
    color: #fff;
    text-align: center;
    font-size: 18px;
    font-weight: 600;
    padding: 14px 10px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
}

/* iframe wrapper spacing */
.stylish-enquire .npf_wgts {
    padding: 15px;
    background: #fff;
}

/* iframe clean look */
.stylish-enquire iframe {
    border: none;
    width: 100%;
}
.enq_form{padding: 10px;}
/* Button Wrapper */
.cta-buttons {
    display: flex;
    gap: 20px;
    justify-content: center;
    align-items: center;
    padding: 20px 0;
    flex-wrap: wrap;
}

/* Common Button Style */
.cta-buttons .btn {
    min-width: 230px;
    padding: 14px 22px;
    text-align: center;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    border-radius: 0;
    transition: all 0.3s ease;
    letter-spacing: 0.3px;
}

/* Yellow Buttons */
 

/* Blue Button */
.btn-blue {
    background: #dddddd;
    color: #000;
}

.btn-blue:hover {
    background: #155a9c;
    color: #fff;
}

	.socialtwitter {
		display: none !important;
	}

	@media only screen and (max-width: 1000px) {
		.menu-toggle {
			display: block !important;
		}
	}

	@media only screen and (max-width: 767px) {

		 .stylish-enquire .enquire-header {
        font-size: 16px;
        padding: 12px;
    }

    .stylish-enquire .npf_wgts {
        padding: 10px;
    }
	  .cta-buttons {
        flex-direction: column;
    }

    .cta-buttons .btn {
        width: 100%;
        max-width: 320px;
    }

		.scroll-hide button {
			height: 34px;
			width: 52%;
			left: -73px;
			font-size: 14px;
			top: 80px;
		}



		.scroll-hide img {
			width: 228px;
		}

		.scroll-hide {
			bottom: 14%;
		}

		.scroll-hide.open {
			right: -228px;
		}

		.logo img {
			width: 215px;
		}

		.Students-component ul li span small {
			font-size: 14px;
		}

		.social {
			display: none;
		}

		.programs-page-navigation {
			margin-top: -2px !important;
		}

		.topheadsection {
			display: block;
		}

		.socialtwitter a {
			color: #fff;
			border: none;
			padding: 4px 12px;
			background: #da2032;
			color: #ffffff;
			display: inline-block;
			font-size: 16px;
			font-weight: 600;
			text-decoration: none;
		}

		.socialtwitter a:hover {
			background: #a70b1a;
		}

		.socialtwitter {
			right: 0px;
			position: fixed;
			vertical-align: middle;
			text-align: center;

			top: 40%;
			text-transform: uppercase;
			-moz-transform: rotate(-90deg);
			-ms-transform: rotate(-90deg);
			-o-transform: rotate(-90deg);
			-webkit-transform: rotate(-90deg);
			transform-origin: bottom right;
			margin-left: -200px;
			width: 230px;
			padding: 0;
			display: inline-table;
			height: 0px;

			-moz-transition-property: margin-left;
			-moz-transition-duration: 0.2s;
			-moz-transition-delay: 0.2s;
			-ms-transition-property: margin-left;
			-ms-transition-duration: 0.2s;
			-ms-transition-delay: 0.2s;
			-o-transition-property: margin-left;
			-o-transition-duration: 0.2s;
			-o-transition-delay: 0.2s;
			-webkit-transition-property: margin-left;
			-webkit-transition-duration: 0.2s;
			-webkit-transition-delay: 0.2s;

			cursor: pointer;
			z-index: 999;
			color: #fff !important;
		}



	}

	@media only screen and (max-width: 850px) and (min-width: 400px) {
		.stickyform2 {
			display: block;
		}

		#top_slides {
			display: none !important;
		}

		.tp_slide .imag-sec1 {
			font-size: 10px !important;
		}

		.tp_slide .imag-sec1 {
			width: 68% !important;
			margin-top: 2px;
			padding: 0px !important;
		}

		.tp_slide .mfx a {
			display: none;
		}
	}

	@media only screen and (max-width: 375px) {
		.Students-component ul li {
			width: 100%;
		}

		.Students-component ul {
			display: flex;
			flex-direction: column;
			align-items: center;
		}

		#top_slides {
			display: none !important;
		}
	}

	.social {
		position: fixed;
		z-index: 25;
		top: 40%;
		left: -170px;
	}

	.social ul {
		list-style-type: none;
		padding: 0;

	}

	.social ul li img {

		width: 24px;
	}

	.social ul li {
		display: block;
		margin: 3px 7px;
		background-color: #005a9e;
		width: 100%;
		text-align: right;
		padding: 6px;
		transition: all 1s;
	}

	.social ul li:hover {
		transform: translatex(140px);
	}



	.social ul li a {
		color: white;
		text-decoration: none;
	}

	.social ul li i {
		text-align: center;
		margin-left: 14px;
		color: white;
		padding: 4px 1px 2px 4px;
		border-radius: 50%;
		font-size: 19px;
		transform: rotate(0deg);
	}

	.social ul li:hover i {
		transform: rotate(360deg);
		transition: all 1s;
	}

	.ft_ {
		display: flex !important;
		align-items: center;
		justify-content: flex-end;
	}

	.ft-so__ {
		margin-right: 22px;
	}

	.ft-so__ i {
		margin-left: 0px !important;
	}

	.tp_slide .imag-sec1 {
		height: 26px;
		display: block;
		float: left;
		width: 80%;
		background: #fff3cd;
		/* width: auto; */
		color: #000;
		padding: 0 40px;
		font-size: 13px;
		line-height: 25px;
		font-weight: 500;
		border-radius: 5px;
		text-align: center;
	}

	.tp_slide a,
	.left_btn a {
		font-size: 12px;
		color: #fff;
		text-decoration: none;
		border: 0;
		position: relative;
		font-weight: 500;
		background-color: #d79e2f;
		border-radius: 5px;
		padding: 5px 15px;
		margin: 0 2px 0 0;
		float: right;
	}

	/* .programs-page-navigation {
		margin: 28px 0;
	} */

	.left_btn span {
		font-size: 13px;
		margin: 0 -4px;
	}
