<style>
	.blink_new {
		color: red;
		background-color: #fff;
		padding: 2px 6px;
		border-radius: 4px;
		animation: blinker 1s linear infinite;
		font-size: 14px !important;
	}

	@keyframes blinker {
		50% {
			opacity: 0;
		}
	}

	._bedropdownmenu ol li {
		background: var(--wpr-bg-cf49cf22-aa56-46ce-b5b6-e75b4dc3d7cf) 0px 6px no-repeat;
