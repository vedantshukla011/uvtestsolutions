	<script>
		const menuToggle = document.getElementById("menuToggle");
		const menuOverlay = document.getElementById("menuOverlay");
		const closeBtn = document.getElementById("closeBtn");
		const backSection = document.getElementById("backSection");
		const currentMenuTitle = document.getElementById("currentMenuTitle");
		const pageContent = document.getElementById("pageContent");
		const menuSlides = document.querySelectorAll(".menu-slide");
		const closeBtnx = document.getElementsByClassName("close-btn");
		let navigationStack = ["mainMenu"];
		let titleStack = [""];
		let lastMenu = null;

		Array.from(closeBtnx).forEach(btn => {
			btn.addEventListener("click", () => {
				const chatbotIndicator = document.querySelector(".default-chatbot-indicator");
				if (chatbotIndicator) {
					chatbotIndicator.classList.remove("open");

				}
			});
		});

		// Open menu overlay
		menuToggle.addEventListener("click", () => {
			// Avoid multiple reflows
			requestAnimationFrame(() => {
				menuOverlay.style.display = "block";
				menuOverlay.offsetHeight; // Force reflow
				menuOverlay.classList.add("active");

				const chatbotIndicator = document.querySelector(".default-chatbot-indicator");
				if (chatbotIndicator) chatbotIndicator.classList.add("open");
			});
		});

		// Close menu overlay
		if (closeBtn) {
			closeBtn.addEventListener("click", () => {
				menuOverlay.classList.remove("active");
				pageContent.classList.remove("menu-open");
				document.body.style.overflow = "";



				setTimeout(() => {
					resetToMainMenu();
				}, 300);
			});
		}



		// Navigation handler - target menu-list links
		menuOverlay.addEventListener("click", (e) => {
			const link = e.target.closest(".menu-list a");
			if (link && link.dataset.submenu) {
				e.preventDefault();
				const submenuId = link.dataset.submenu;
				const menuTitle = link.dataset.title || link.textContent.trim();
				navigateToSubmenu(submenuId, menuTitle);
			}
		});

		// Dropdown accordion functionality
		// Dropdown accordion functionality (only one open at a time per slide)
		menuOverlay.addEventListener("click", (e) => {
			const dropdownHeader = e.target.closest(".dropdown-header");
			if (dropdownHeader) {
				const dropdown = dropdownHeader.parentElement;
				const parentSlide = dropdown.closest(".menu-slide");

				// Close all other dropdowns in the same slide
				parentSlide.querySelectorAll(".dropdown").forEach((item) => {
					if (item !== dropdown) {
						item.classList.remove("open");
					}
				});

				// Toggle the clicked one
				dropdown.classList.toggle("open");
			}
		});

		// Back button
		backSection.addEventListener("click", () => {
			navigateBack();
		});

		function navigateToSubmenu(submenuId, menuTitle) {
			// Hide current slide
			const currentSlide = document.getElementById(
				navigationStack[navigationStack.length - 1]
			);
			currentSlide.classList.remove("active");

			// Show new slide
			const newSlide = document.getElementById(submenuId);
			newSlide.classList.add("active");

			// Add to navigation stack
			navigationStack.push(submenuId);
			titleStack.push(menuTitle);

			// Show back section with menu title
			if (navigationStack.length > 1) {
				backSection.classList.add("active");
				currentMenuTitle.textContent = menuTitle;
			}
		}

		function navigateBack() {
			if (navigationStack.length > 1) {
				// Remove current slide from stack
				const currentSlideId = navigationStack.pop();
				titleStack.pop();
				const currentSlide = document.getElementById(currentSlideId);
				currentSlide.classList.remove("active");

				// Show previous slide
				const previousSlideId = navigationStack[navigationStack.length - 1];
				const previousSlide = document.getElementById(previousSlideId);
				previousSlide.classList.add("active");

				// Update or hide back section
				if (navigationStack.length === 1) {
					backSection.classList.remove("active");
				} else {
					currentMenuTitle.textContent = titleStack[titleStack.length - 1];
				}
			}
		}

		function resetToMainMenu() {
			// Hide all slides
			menuSlides.forEach((slide) => slide.classList.remove("active"));

			// Show main menu
			document.getElementById("mainMenu").classList.add("active");

			// Reset navigation stack
			navigationStack = ["mainMenu"];
			titleStack = [""];

			// Hide back section
			backSection.classList.remove("active");

			// Close all dropdowns
			document.querySelectorAll(".dropdown").forEach((dropdown, index) => {
				if (index === 0) {
					dropdown.classList.add("open");
				} else {
					dropdown.classList.remove("open");
				}
			});
		}

		// Prevent body scroll when menu is open
		menuOverlay.addEventListener(
			"touchmove",
			(e) => {
				e.stopPropagation();
			}, {
				passive: false
			}
		);


		(function() {
			// Initialize all tab groups on the page
			function initTabGroups() {
				const tabGroups = document.querySelectorAll('[data-tab-group]');

				tabGroups.forEach(group => {
					const groupName = group.getAttribute('data-tab-group');
					const buttons = group.querySelectorAll('.tab-button-dyn');
					const contents = group.querySelectorAll('.tab-content-dyn');

					let activeTab = null;
					let hoverTimeout = null;

					// Find initially active tab
					buttons.forEach(btn => {
						if (btn.classList.contains('active-dyn')) {
							activeTab = btn.getAttribute('data-tab-target');
						}
					});

					function switchTab(tabId) {
						if (activeTab === tabId) return;

						// Remove active class from all
						buttons.forEach(btn => btn.classList.remove('active-dyn'));
						contents.forEach(content => content.classList.remove('active-dyn'));

						// Add active class to selected
						const activeButton = group.querySelector(`[data-tab-target="${tabId}"]`);
						const activeContent = group.querySelector(`[data-tab-content="${tabId}"]`);

						if (activeButton && activeContent) {
							activeButton.classList.add('active-dyn');
							activeContent.classList.add('active-dyn');
							activeTab = tabId;
						}
					}

					// Add event listeners
					buttons.forEach(button => {
						// Hover event
						button.addEventListener('mouseenter', () => {
							clearTimeout(hoverTimeout);
							hoverTimeout = setTimeout(() => {
								const tabId = button.getAttribute('data-tab-target');
								switchTab(tabId);
							}, 100);
						});

						button.addEventListener('mouseleave', () => {
							clearTimeout(hoverTimeout);
						});

						// Click event
						button.addEventListener('click', () => {
							clearTimeout(hoverTimeout);
							const tabId = button.getAttribute('data-tab-target');
							switchTab(tabId);
						});
					});
				});
			}

			// Initialize on page load
			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', initTabGroups);
			} else {
				initTabGroups();
			}
		})();
	</script>


	<script>
		$('.scroll-hide button').on('click', function() {
			$('.scroll-hide').toggleClass('open');

		});
	</script><div data-rocket-location-hash="d55264d4279b1254ac25d3be56ec0ce3" class="programs_menu">
